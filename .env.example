# Copy to .env to override the docker-compose.yml defaults (.env is gitignored).
# If you change the credentials or ports, enter the same values in the app:
# Settings → "Сховище зображень (MinIO)".

MINIO_ROOT_USER=etsytracker
# At least 8 characters. The default below is public — replace it with your own
# (e.g. `openssl rand -hex 16`) and enter the same value in the app's Settings.
MINIO_ROOT_PASSWORD=etsytracker-minio-secret

# Origins allowed to call the S3 API from a browser (default: the console only).
MINIO_CORS_ALLOW_ORIGIN=http://127.0.0.1:9101

# Host ports (bound to 127.0.0.1 only).
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# MinIO no longer publishes community images on Docker Hub. The default
# minio/minio:RELEASE.2025-09-07T16-13-09Z works where that image is already
# cached; elsewhere use a maintained community build, e.g.:
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
