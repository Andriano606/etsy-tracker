{
  "name": "etsy-tracker",
  "version": "0.1.0",
  "description": "Desktop app that watches Etsy shops through the official Etsy Open API v3 and reports which listings are new since the last scan",
  "main": "./out/main/index.js",
  "author": {
    "name": "andrii",
    "email": "andrii.kuluiev@partingpro.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:fixtures": "node scripts/ui-harness/copy-db.cjs && vite-node scripts/ui-harness/fixtures.ts -- .ui-harness/copy.db .ui-harness/fixtures.json",
    "ui:shots": "electron scripts/ui-harness/main.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "minio": "^8.0.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^38.8.6",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vitest": "^2.1.9"
  }
}
